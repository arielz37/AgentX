+import SwiftUI
+import UIKit
+
+// No XCTest import or UI automation session. A bounded, user-prepared import only.
+@MainActor
+final class CalendarHost: ObservableObject {
+    @Published var message = "准备连接 Mac"
+    @Published var ready = false
+    private let calendar = CalendarBridge(executionLocation: "iphone_native_app")
+    private var server: SimulatorRPCServer?
+    private var backgroundTask: UIBackgroundTaskIdentifier = .invalid
+    private var deadline: Date?
+    private var timer: Timer?
+
+    func start() {
+        guard server == nil, UIApplication.shared.applicationState == .active else { return }
+        do {
+            server = try SimulatorRPCServer(onReady: { _ in
+                print("WELLPHONE_NATIVE_RPC_READY port=45678")
+                Task { @MainActor in self.ready = true; self.message = "等待 Mac 授权、锁定和准备导入" }
+            }, onStop: {
+                Task { @MainActor in self.finish("导入会话结束，请在 Mac 查看真实结果") }
+            }, commandHandler: { [weak self] method, params in
+                guard let self else { throw NSError(domain: "Wellphone.Host", code: 1) }
+                return try await self.handle(method, params)
+            })
+            server?.start()
+        } catch { message = error.localizedDescription }
+    }
+
+    func armFromPhone() {
+        Task {
+            do { _ = try await handle("calendar_arm", [:]) }
+            catch { message = error.localizedDescription }
+        }
+    }
+
+    private func problem(_ message: String) -> NSError {
+        NSError(domain: "Wellphone.Host", code: 1, userInfo: [NSLocalizedDescriptionKey: message])
+    }
+
+    private func hostStatus() -> [String: Any] {
+        let remaining = UIApplication.shared.backgroundTimeRemaining
+        return ["application_state": UIApplication.shared.applicationState == .active ? "foreground" : (UIApplication.shared.applicationState == .background ? "background" : "inactive"),
+                "background_budget_seconds": remaining.isFinite && remaining < 1e9 ? remaining : -1,
+                "import_armed": backgroundTask != .invalid,
+                "window_remaining_seconds": max(0, deadline?.timeIntervalSinceNow ?? 0)]
+    }
+
+    private func handle(_ method: String, _ params: [String: Any]) async throws -> (result: Any, shouldStop: Bool) {
+        if method == "stop" { return ([:], true) }
+        guard method.hasPrefix("calendar_") else { throw problem("Native host supports calendar RPC only") }
+        if method == "calendar_prepare" {
+            guard UIApplication.shared.applicationState == .active else {
+                throw problem("Permission preparation requires the host in foreground")
+            }
+        }
+        if method == "calendar_arm" {
+            guard calendar.isLocked, UIApplication.shared.applicationState == .active,
+                  backgroundTask == .invalid else { throw problem("Arm once in foreground after calendar_lock") }
+            // A short pending import, not a perpetual background service. The OS may grant
+            // less time than our 45-second cap. Never renew from the background.
+            backgroundTask = UIApplication.shared.beginBackgroundTask(withName: "Wellphone calendar import") { [weak self] in
+                Task { @MainActor in self?.finish("系统后台时间已到，未完成任务请在 Mac 检查") }
+            }
+            guard backgroundTask != .invalid else { throw problem("System denied background execution time") }
+            deadline = Date().addingTimeInterval(45)
+            timer = Timer.scheduledTimer(withTimeInterval: 45, repeats: false) { [weak self] _ in
+                Task { @MainActor in self?.finish("45 秒导入窗口已到；没有自动重试") }
+            }
+            message = "导入窗口已开启，请切到游戏/输入界面；系统可能提前结束窗口"
+            var status = try await calendar.handle("calendar_status", [:])
+            status["host"] = hostStatus()
+            return (status, false)
+        }
+        if method == "calendar_execute" {
+            guard backgroundTask != .invalid, let deadline, deadline > Date() else {
+                throw problem("import_window_expired_or_not_armed: prepare again in foreground; no writes attempted")
+            }
+            // Fail closed: this experiment must actually execute while the human's app is in front.
+            guard UIApplication.shared.applicationState == .background else {
+                throw problem("Host must be in background before executing the experiment")
+            }
+        }
+        var result = try await calendar.handle(method, params)
+        result["host"] = hostStatus()
+        // Finish the background assertion after the actual RPC response has been sent.
+        return (result, method == "calendar_execute")
+    }
+
+    private func finish(_ text: String) {
+        server?.stop(); server = nil
+        timer?.invalidate(); timer = nil
+        deadline = nil
+        if backgroundTask != .invalid {
+            UIApplication.shared.endBackgroundTask(backgroundTask)
+            backgroundTask = .invalid
+        }
+        ready = false; message = text
+    }
+}
+
+struct CalendarHostView: View {
+    @StateObject private var host = CalendarHost()
+    @Environment(\.scenePhase) private var phase
+    var body: some View {
+        VStack(alignment: .leading, spacing: 20) {
+            Text("Wellphone 日历实验").font(.largeTitle.bold())
+            Text(host.message)
+            Text("仅在有限后台窗口内完成一次导入。任务完成或时间到后停止。没有 XCTest 自动化水印，不使用音频保活。")
+                .foregroundStyle(.secondary)
+            Button("准备连接 Mac") { host.start() }.disabled(host.ready)
+            Button("开启一次导入窗口") { host.armFromPhone() }.disabled(!host.ready)
+            Text("授权完成后，由 Mac 开启窗口，再手动切到游戏或输入界面。结果在 Mac 显示。")
+                .font(.footnote)
+        }
+        .padding(24)
+        .onAppear { host.start() }
+        .onChange(of: phase) { _, newPhase in
+            if newPhase == .active && !host.ready { host.start() }
+        }
+    }
+}
